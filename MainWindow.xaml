<Window x:Class="FlowInk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowInk"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowState="Maximized">

    <Window.Resources>
        <VisualBrush x:Key="CheckerBrush"
                     TileMode="Tile"
                     Viewport="0,0,8,8"
                     ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="8" Height="8" Background="#FFFFFFFF">
                    <Rectangle Width="4"
                               Height="4"
                               Fill="#FFD0D0D0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                    <Rectangle Width="4"
                               Height="4"
                               Fill="#FFD0D0D0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DimGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#AAFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid Margin="2" ClipToBounds="True">
                                <Border CornerRadius="2"
                                        Background="{StaticResource CheckerBrush}"/>

                                <Border x:Name="InnerBorder"
                                        CornerRadius="2"
                                        Background="{TemplateBinding Background}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PenWidthPresetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF666666"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <InkCanvas x:Name="DrawingCanvas"
                   Background="#01000000"
                   EditingMode="Ink" />

        <Border x:Name="ToolbarPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="8"
                Padding="2"
                CornerRadius="11"
                Background="#881E1E1E"
                PreviewMouseLeftButtonDown="ToolbarPanel_PreviewMouseLeftButtonDown"
                PreviewMouseMove="ToolbarPanel_PreviewMouseMove"
                PreviewMouseLeftButtonUp="ToolbarPanel_PreviewMouseLeftButtonUp"
                LostMouseCapture="ToolbarPanel_LostMouseCapture">
            <StackPanel Orientation="Vertical">
                <Border Height="8"
                        Background="#01000000"/>

                <Button x:Name="PenButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="✎"
                        ToolTip="Pen（右クリック: 線幅設定）"
                        PreviewMouseLeftButtonDown="PenButton_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonUp="PenButton_PreviewMouseRightButtonUp"/>

                <Popup x:Name="PenWidthPopup"
                       PlacementTarget="{Binding ElementName=PenButton}"
                       Placement="Left"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="#EE1E1E1E"
                            Padding="10"
                            CornerRadius="10"
                            BorderBrush="#FF555555"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Pen Width"
                                       Foreground="White"
                                       Margin="0,0,0,8"
                                       FontWeight="Bold"/>

                            <UniformGrid x:Name="PenWidthPresetGrid"
                                         Columns="1"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="RectangleButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="▭"
                        ToolTip="Rectangle（右クリック: 設定）"
                        PreviewMouseLeftButtonDown="RectangleButton_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonUp="RectangleButton_PreviewMouseRightButtonUp"
                        Click="RectangleButton_Click"/>

                <Button x:Name="CircleButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="◯"
                        ToolTip="Circle（右クリック: 設定）"
                        PreviewMouseLeftButtonDown="CircleButton_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonUp="CircleButton_PreviewMouseRightButtonUp"
                        Click="CircleButton_Click"/>

                <Popup x:Name="RectangleSettingsPopup"
                       PlacementTarget="{Binding ElementName=RectangleButton}"
                       Placement="Left"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="#EE1E1E1E"
                            Padding="10"
                            CornerRadius="10"
                            BorderBrush="#FF555555"
                            BorderThickness="1">
                        <StackPanel Width="180">
                            <TextBlock Text="Shape"
                                       Foreground="White"
                                       Margin="0,0,0,8"
                                       FontWeight="Bold"/>

                            <CheckBox x:Name="RectangleFillCheckBox"
                                      Content="塗りつぶし"
                                      Foreground="White"
                                      Margin="0,0,0,10"
                                      Checked="RectangleFillCheckBox_Changed"
                                      Unchecked="RectangleFillCheckBox_Changed"/>

                            <TextBlock x:Name="RectangleOpacityLabel"
                                       Text="透明度: 35%"
                                       Foreground="White"
                                       Margin="0,0,0,4"/>

                            <Slider x:Name="RectangleOpacitySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="35"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="RectangleOpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="TextButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="T"
                        ToolTip="Text（ダブルクリックでフォント設定）"
                        PreviewMouseLeftButtonDown="TextButton_PreviewMouseLeftButtonDown"
                        Click="TextButton_Click"/>

                <Button x:Name="EraserButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="⌫"
                        ToolTip="Erase"
                        Click="EraserButton_Click"/>

                <Button x:Name="ColorButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Color（ダブルクリックで現在色を編集）"
                        PreviewMouseLeftButtonDown="ColorButton_PreviewMouseLeftButtonDown">
                    <Grid Width="18" Height="18">
                        <Ellipse Fill="{StaticResource CheckerBrush}"
                                 Stroke="#AAFFFFFF"
                                 StrokeThickness="1"/>

                        <Ellipse x:Name="CurrentColorPreviewEllipse"
                                 Fill="#FFFF0000"
                                 Stroke="#AAFFFFFF"
                                 StrokeThickness="1"/>

                        <Ellipse Stroke="#55000000"
                                 StrokeThickness="1"
                                 IsHitTestVisible="False"/>
                    </Grid>
                </Button>

                <Popup x:Name="ColorPopup"
                       PlacementTarget="{Binding ElementName=ColorButton}"
                       Placement="Left"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="#EE1E1E1E"
                            Padding="10"
                            CornerRadius="10"
                            BorderBrush="#FF555555"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Recent Colors"
                                       Foreground="White"
                                       Margin="0,0,0,8"
                                       FontWeight="Bold"/>

                            <UniformGrid x:Name="RecentColorGrid"
                                         Columns="4"
                                         Margin="0,0,0,12"/>

                            <TextBlock Text="Preset Colors"
                                       Foreground="White"
                                       Margin="0,0,0,8"
                                       FontWeight="Bold"/>

                            <UniformGrid x:Name="PresetColorGrid"
                                         Columns="4"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="ClearButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="🗑"
                        ToolTip="Clear"
                        Click="ClearButton_Click"/>

                <Button x:Name="ClickThroughButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="CT"
                        FontSize="12"
                        ToolTip="Click Through"
                        Click="ClickThroughButton_Click"/>

                <Button x:Name="ExitButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Content="×"
                        ToolTip="Exit"
                        Click="ExitButton_Click"/>

                <Border Height="8"
                        Background="#01000000"/>
            </StackPanel>
        </Border>

        <Border x:Name="ToastBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Padding="14,8"
                CornerRadius="10"
                Background="#DD1E1E1E"
                BorderBrush="#AA666666"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastTextBlock"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="描画OFF。タスクトレイから戻せます。"/>
        </Border>
    </Grid>
</Window>