<Window x:Class="FlowInk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlowInk"
        xmlns:res="clr-namespace:FlowInk.Properties"
        Title="FlowInk"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">

    <Window.Resources>
        <VisualBrush x:Key="CheckerBrush"
                     TileMode="Tile"
                     Viewport="0,0,8,8"
                     ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="8" Height="8" Background="#FFFFFFFF">
                    <Rectangle Width="4"
                               Height="4"
                               Fill="#FFD0D0D0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                    <Rectangle Width="4"
                               Height="4"
                               Fill="#FFD0D0D0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DimGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ToolbarMiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="DimGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#AAFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBorder"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid Margin="2" ClipToBounds="True">
                                <Border CornerRadius="2"
                                        Background="{StaticResource CheckerBrush}"/>

                                <Border x:Name="InnerBorder"
                                        CornerRadius="2"
                                        Background="{TemplateBinding Background}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PenPresetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF666666"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PenWidthPresetButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PenPresetButtonStyle}"/>
    </Window.Resources>

    <Grid>
        <local:LineStyleInkCanvas x:Name="DrawingCanvas"
                                  Background="#01000000"
                                  EditingMode="Ink" />

        <Border x:Name="ToolbarPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="8"
                Padding="2"
                CornerRadius="11"
                Background="#881E1E1E"
                PreviewMouseLeftButtonDown="ToolbarPanel_PreviewMouseLeftButtonDown"
                PreviewMouseMove="ToolbarPanel_PreviewMouseMove"
                PreviewMouseLeftButtonUp="ToolbarPanel_PreviewMouseLeftButtonUp"
                LostMouseCapture="ToolbarPanel_LostMouseCapture">
            <Grid>
                <StackPanel x:Name="FullToolbarPanel"
                            Orientation="Vertical">
                    <Border Height="8"
                            Background="#01000000"/>

                    <Button x:Name="ClickThroughButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="{x:Static res:Resources.DrawingToolTip}"
                            Click="ClickThroughButton_Click">
                        <TextBlock x:Name="ClickThroughButtonLabel"
                                   Text="{x:Static res:Resources.DrawingOn}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="PenButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="✎"
                            ToolTip="{x:Static res:Resources.PenToolTip}"
                            PreviewMouseLeftButtonDown="PenButton_PreviewMouseLeftButtonDown"
                            PreviewMouseRightButtonUp="PenButton_PreviewMouseRightButtonUp"/>

                    <Popup x:Name="PenPresetPopup"
                           PlacementTarget="{Binding ElementName=PenButton}"
                           Placement="Left"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#EE1E1E1E"
                                Padding="8"
                                CornerRadius="10"
                                BorderBrush="#FF555555"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Resources.PenPresets}"
                                           Foreground="White"
                                           Margin="0,0,0,6"
                                           FontWeight="Bold"/>

                                <UniformGrid x:Name="PenPresetGrid"
                                             Columns="4"/>

                                <Border Height="1"
                                        Background="#FF555555"
                                        Margin="0,8,0,8"/>

                                <TextBlock Text="{x:Static res:Resources.PenWidthPresets}"
                                           Foreground="White"
                                           Margin="0,0,0,6"
                                           FontWeight="Bold"/>

                                <UniformGrid x:Name="PenWidthPresetGrid"
                                             Columns="4"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="LineStyleButton"
                            Visibility="Collapsed"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="{x:Static res:Resources.LineStyle}"
                            Click="LineStyleButton_Click">
                        <Grid Width="20"
                              Height="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Line x:Name="LineStyleButtonPreview"
                                  X1="2"
                                  Y1="5"
                                  X2="18"
                                  Y2="5"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeDashCap="Round"
                                  SnapsToDevicePixels="True"/>
                        </Grid>
                    </Button>

                    <Popup x:Name="LineStylePopup"
                           PlacementTarget="{Binding ElementName=LineStyleButton}"
                           Placement="Left"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#EE1E1E1E"
                                Padding="8"
                                CornerRadius="10"
                                BorderBrush="#FF555555"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Resources.LineStyle}"
                                           Foreground="White"
                                           Margin="0,0,0,6"
                                           FontWeight="Bold"/>

                                <UniformGrid x:Name="LineStyleGrid"
                                             Columns="1"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="SelectButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="{x:Static res:Resources.Select}"
                            Click="SelectButton_Click">
                        <Viewbox Width="18"
                                 Height="18"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Grid Width="20"
                                  Height="20">
                                <Path Data="M 3,1 L 3,16 L 7.2,12.4 L 10.4,19 L 13.1,17.7 L 9.9,11.4 L 15.6,11.4 Z"
                                      Fill="White"
                                      Stroke="#FF1A1A1A"
                                      StrokeThickness="1"
                                      StrokeLineJoin="Round"/>
                            </Grid>
                        </Viewbox>
                    </Button>

                    <Button x:Name="RectangleButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="▭"
                            ToolTip="{x:Static res:Resources.RectangleNotFilledToolTip}"
                            PreviewMouseLeftButtonDown="RectangleButton_PreviewMouseLeftButtonDown"
                            PreviewMouseRightButtonUp="RectangleButton_PreviewMouseRightButtonUp"
                            Click="RectangleButton_Click"/>

                    <Button x:Name="CircleButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="◯"
                            ToolTip="{x:Static res:Resources.CircleNotFilledToolTip}"
                            PreviewMouseLeftButtonDown="CircleButton_PreviewMouseLeftButtonDown"
                            PreviewMouseRightButtonUp="CircleButton_PreviewMouseRightButtonUp"
                            Click="CircleButton_Click"/>

                    <Popup x:Name="RectangleSettingsPopup"
                           PlacementTarget="{Binding ElementName=RectangleButton}"
                           Placement="Left"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#EE1E1E1E"
                                Padding="10"
                                CornerRadius="10"
                                BorderBrush="#FF555555"
                                BorderThickness="1">
                            <StackPanel Width="180">
                                <TextBlock Text="{x:Static res:Resources.Shape}"
                                           Foreground="White"
                                           Margin="0,0,0,8"
                                           FontWeight="Bold"/>

                                <CheckBox x:Name="RectangleFillCheckBox"
                                          Content="{x:Static res:Resources.Fill}"
                                          Foreground="White"
                                          Margin="0,0,0,10"
                                          Checked="RectangleFillCheckBox_Changed"
                                          Unchecked="RectangleFillCheckBox_Changed"/>

                                <TextBlock x:Name="RectangleOpacityLabel"
                                           Text="{x:Static res:Resources.Transparency}"
                                           Foreground="White"
                                           Margin="0,0,0,4"/>

                                <Slider x:Name="RectangleOpacitySlider"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="35"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="RectangleOpacitySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="TextButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="T"
                            ToolTip="{x:Static res:Resources.TextToolTip}"
                            PreviewMouseRightButtonUp="TextButton_PreviewMouseRightButtonUp"
                            Click="TextButton_Click"/>

                    <Button x:Name="EraserButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="⌫"
                            ToolTip="{x:Static res:Resources.Eraser}"
                            PreviewMouseRightButtonUp="EraserButton_PreviewMouseRightButtonUp"
                            Click="EraserButton_Click"/>

                    <Popup x:Name="EraserWidthPopup"
                           PlacementTarget="{Binding ElementName=EraserButton}"
                           Placement="Left"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#EE1E1E1E"
                                Padding="10"
                                CornerRadius="10"
                                BorderBrush="#FF555555"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Resources.EraserWidth}"
                                           Foreground="White"
                                           Margin="0,0,0,8"
                                           FontWeight="Bold"/>

                                <UniformGrid x:Name="EraserWidthPresetGrid"
                                             Columns="4"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="ColorButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="{x:Static res:Resources.ColorToolTip}"
                            Click="ColorButton_Click"
                            PreviewMouseRightButtonUp="ColorButton_PreviewMouseRightButtonUp">
                        <Grid Width="18" Height="18">
                            <Ellipse Fill="{StaticResource CheckerBrush}"
                                     Stroke="#AAFFFFFF"
                                     StrokeThickness="1"/>

                            <Ellipse x:Name="CurrentColorPreviewEllipse"
                                     Fill="#FFFF0000"
                                     Stroke="#AAFFFFFF"
                                     StrokeThickness="1"/>

                            <Ellipse Stroke="#55000000"
                                     StrokeThickness="1"
                                     IsHitTestVisible="False"/>
                        </Grid>
                    </Button>

                    <Popup x:Name="ColorPopup"
                           PlacementTarget="{Binding ElementName=ColorButton}"
                           Placement="Left"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#EE1E1E1E"
                                Padding="10"
                                CornerRadius="10"
                                BorderBrush="#FF555555"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Resources.RecentColors}"
                                           Foreground="White"
                                           Margin="0,0,0,8"
                                           FontWeight="Bold"/>

                                <UniformGrid x:Name="RecentColorGrid"
                                             Columns="4"
                                             Margin="0,0,0,12"/>

                                <TextBlock Text="{x:Static res:Resources.PresetColors}"
                                           Foreground="White"
                                           Margin="0,0,0,8"
                                           FontWeight="Bold"/>

                                <UniformGrid x:Name="PresetColorGrid"
                                             Columns="4"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="UndoRedoButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="{x:Static res:Resources.UndoRedoToolTip}"
                            Click="UndoRedoButton_Click"
                            MouseRightButtonUp="UndoRedoButton_MouseRightButtonUp">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="↶"
                                       FontFamily="Segoe UI Symbol"
                                       Margin="0,0,2,0"/>
                            <TextBlock Text="↷"
                                       FontFamily="Segoe UI Symbol"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ClearButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="🗑"
                            ToolTip="{x:Static res:Resources.Clear}"
                            Click="ClearButton_Click"/>

                    <Button x:Name="SettingsButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="⚙"
                            ToolTip="{x:Static res:Resources.SettingsToolTip}"
                            Click="SettingsButton_Click"/>

                    <Popup x:Name="HotkeySettingsPopup"
                           PlacementTarget="{Binding ElementName=SettingsButton}"
                           Placement="Left"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#EE1E1E1E"
                                Padding="10"
                                CornerRadius="10"
                                BorderBrush="#FF555555"
                                BorderThickness="1">
                            <StackPanel Width="190">
                                <TextBlock Text="{x:Static res:Resources.Hotkey}"
                                           Foreground="White"
                                           Margin="0,0,0,8"
                                           FontWeight="Bold"/>

                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="HotkeyCtrlCheckBox"
                                              Content="{x:Static res:Resources.HotkeyModifierCtrl}"
                                              Foreground="White"
                                              Margin="0,0,10,4"
                                              Checked="HotkeySettingControl_Changed"
                                              Unchecked="HotkeySettingControl_Changed"/>
                                    <CheckBox x:Name="HotkeyAltCheckBox"
                                              Content="{x:Static res:Resources.HotkeyModifierAlt}"
                                              Foreground="White"
                                              Margin="0,0,10,4"
                                              Checked="HotkeySettingControl_Changed"
                                              Unchecked="HotkeySettingControl_Changed"/>
                                    <CheckBox x:Name="HotkeyShiftCheckBox"
                                              Content="{x:Static res:Resources.HotkeyModifierShift}"
                                              Foreground="White"
                                              Margin="0,0,10,4"
                                              Checked="HotkeySettingControl_Changed"
                                              Unchecked="HotkeySettingControl_Changed"/>
                                    <CheckBox x:Name="HotkeyWinCheckBox"
                                              Content="{x:Static res:Resources.HotkeyModifierWin}"
                                              Foreground="White"
                                              Margin="0,0,10,4"
                                              Checked="HotkeySettingControl_Changed"
                                              Unchecked="HotkeySettingControl_Changed"/>
                                </WrapPanel>

                                <ComboBox x:Name="HotkeyKeyComboBox"
                                          Margin="0,0,0,8"
                                          SelectionChanged="HotkeyKeyComboBox_SelectionChanged"/>

                                <TextBlock Text="{x:Static res:Resources.CurrentSettings}"
                                           Foreground="#FFBFBFBF"
                                           FontSize="11"/>
                                <TextBlock x:Name="HotkeyPreviewTextBlock"
                                           Foreground="White"
                                           Margin="0,2,0,10"
                                           FontWeight="SemiBold"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="{x:Static res:Resources.Cancel}"
                                            Width="64"
                                            Margin="0,0,6,0"
                                            Click="HotkeyCancelButton_Click"/>
                                    <Button Content="{x:Static res:Resources.Save}"
                                            Width="64"
                                            Click="HotkeySaveButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="ExitButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="×"
                            ToolTip="{x:Static res:Resources.Exit}"
                            Click="ExitButton_Click"/>

                    <Border Height="8"
                            Background="#01000000"/>
                </StackPanel>

                <StackPanel x:Name="CtMiniPanel"
                            Width="38"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Border Height="8"
                            Background="#01000000"/>

                    <Button x:Name="CtReturnButton"
                            Style="{StaticResource ToolbarMiniButtonStyle}"
                            ToolTip="{x:Static res:Resources.TrayMenuTurnDrawingOn}"
                            Click="CtReturnButton_Click">
                        <TextBlock x:Name="CtReturnButtonLabel"
                                   Text="{x:Static res:Resources.DrawingOn}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Border Height="8"
                            Background="#01000000"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ToastBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Padding="14,8"
                CornerRadius="10"
                Background="#DD1E1E1E"
                BorderBrush="#AA666666"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastTextBlock"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="{x:Static res:Resources.DrawingDisabledToast}"/>
        </Border>
    </Grid>
</Window>