<Window x:Class="FlowInk.EraserWidthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:FlowInk.Properties"
        Title="{x:Static res:Resources.EraserWidth}"
        Width="320"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="#FF1E1E1E"
        Foreground="White">
    <Border Padding="12">
        <StackPanel>
            <TextBlock Text="{x:Static res:Resources.EraserWidth}"
                       Margin="0,0,0,10"
                       FontWeight="Bold"
                       FontSize="14"/>

            <TextBlock x:Name="PreviewTextBlock"
                       Text="{x:Static res:Resources.CurrentValueDefault}"
                       Margin="0,0,0,8"
                       HorizontalAlignment="Center"
                       FontSize="13"/>

            <Border Background="#FF2A2A2A"
                    BorderBrush="#FF555555"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Slider x:Name="WidthSlider"
                            Minimum="0.5"
                            Maximum="30"
                            TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            ValueChanged="WidthSlider_ValueChanged"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Static res:Resources.PenWidthMinLabel}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Foreground="LightGray"/>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Static res:Resources.PenWidthMaxLabel}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="LightGray"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Canvas Width="260"
                    Height="40"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"
                    IsHitTestVisible="False">
                <Line x:Name="PreviewLine"
                      X1="20"
                      Y1="20"
                      X2="240"
                      Y2="20"
                      Stroke="White"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
            </Canvas>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Content="{x:Static res:Resources.OK}"
                        Width="72"
                        Height="32"
                        Margin="4"
                        Click="OkButton_Click"/>

                <Button x:Name="CancelButton"
                        Content="{x:Static res:Resources.Cancel}"
                        Width="72"
                        Height="32"
                        Margin="4"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
