<Window x:Class="FlowInk.PenPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:FlowInk.Properties"
        Title="{x:Static res:Resources.PenPresetDialogTitle}"
        Width="360"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="#FF1E1E1E"
        Foreground="White">
    <Window.Resources>
        <VisualBrush x:Key="CheckerBrush"
                     TileMode="Tile"
                     Viewport="0,0,8,8"
                     ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="8" Height="8" Background="#FFFFFFFF">
                    <Rectangle Width="4"
                               Height="4"
                               Fill="#FFD0D0D0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                    <Rectangle Width="4"
                               Height="4"
                               Fill="#FFD0D0D0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>
    </Window.Resources>

    <Border Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{x:Static res:Resources.PenPresetDialogTitle}"
                       Margin="0,0,0,10"
                       FontWeight="Bold"
                       FontSize="14"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="#FF2A2A2A"
                            BorderBrush="#FF555555"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Static res:Resources.PenPresetColor}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Margin="0,0,12,0"/>

                            <Border Grid.Column="1"
                                    Width="44"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    BorderBrush="#AAFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="{StaticResource CheckerBrush}">
                                <Rectangle x:Name="ColorPreviewRectangle"
                                           RadiusX="3"
                                           RadiusY="3"
                                           Margin="2"/>
                            </Border>

                            <Button Grid.Column="2"
                                    Content="{x:Static res:Resources.PenPresetChangeColor}"
                                    Width="92"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Click="ColorButton_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="WidthValueTextBlock"
                               Text="{x:Static res:Resources.CurrentValueDefault}"
                               Margin="0,0,0,6"
                               HorizontalAlignment="Center"
                               FontSize="13"/>

                    <Border Background="#FF2A2A2A"
                            BorderBrush="#FF555555"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Resources.PenPresetWidth}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Slider x:Name="WidthSlider"
                                    Minimum="0.5"
                                    Maximum="30"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="WidthSlider_ValueChanged"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Static res:Resources.PenWidthMinLabel}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="LightGray"/>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Static res:Resources.PenWidthMaxLabel}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="LightGray"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="OpacityValueTextBlock"
                               Text="100%"
                               Margin="0,0,0,6"
                               HorizontalAlignment="Center"
                               FontSize="13"/>

                    <Border Background="#FF2A2A2A"
                            BorderBrush="#FF555555"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Resources.PenPresetOpacity}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Slider x:Name="OpacitySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{x:Static res:Resources.PenPresetPreview}"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"/>

                    <Border Background="{StaticResource CheckerBrush}"
                            BorderBrush="#FF555555"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center">
                        <Canvas Width="300"
                                Height="36"
                                IsHitTestVisible="False"
                                ClipToBounds="True">
                            <Line x:Name="PreviewLine"
                                  X1="16"
                                  Y1="18"
                                  X2="284"
                                  Y2="18"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="SaveButton"
                        Content="{x:Static res:Resources.Save}"
                        Width="72"
                        Height="32"
                        Margin="4"
                        Click="SaveButton_Click"/>

                <Button x:Name="CancelButton"
                        Content="{x:Static res:Resources.Cancel}"
                        Width="72"
                        Height="32"
                        Margin="4"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
